@using SongList.Models.ViewModels
@model SongList.Models.ViewModels.HomeIndexViewModel

@{
	GroupListModel gItem = Model.groupList;
	ViewData["Title"] = @gItem.GroupName + "曲リスト";
	ViewData["Description"] = @gItem.Description;
}

<!-- 検索フォーム -->
<div class="top-form">
	<h1 class="page-title">Fillnecode曲リスト</h1>
	<form method="post" asp-action="Index" Content-Type: text/html; charset=utf-8>
		<div class="form-grid">
			<!-- 曲名 -->
			<div class="form-group">
				<div class="field-label-row">
					<label class="field-label">曲名</label>
					<span class="field-tooltip" aria-label="読みで入力する場合は句読点や記号は不要">?</span>
				</div>
				<input type="text" class="input-text" placeholder="曲名を入力" asp-for="searchCondition.SongName" title="読みで入力する場合は句読点や記号は不要">
			</div>
			<!-- アーティスト名 -->
			<div class="form-group">
				<div class="field-label-row">
					<label class="field-label">アーティスト名</label>
					<span class="field-tooltip" aria-label="読みで入力する場合は句読点や記号は不要">?</span>
				</div>
				<input type="text" class="input-text" placeholder="アーティスト名を入力" asp-for="searchCondition.ArtistName" title="読みで入力する場合は句読点や記号は不要">
			</div>
			<!-- ジャンル -->
			<div class="form-group">
				<label class="field-label">ジャンル</label>
				<select class="select-box" asp-for="searchCondition.Genre">
					<option value="">すべて</option>
					@foreach (var genre in Model.genreList)
					{
						@if (Model.searchCondition.Genre == genre.GenreCode)
						{
							<option value="@genre.GenreCode" selected>@genre.GenreName</option>
						}
						else
						{
							<option value="@genre.GenreCode">@genre.GenreName</option>
						}
					}
				</select>
			</div>
			<!-- タイアップ -->
			<div class="form-group">
				<div class="field-label-row">
					<label class="field-label">タイアップ</label>
					<span class="field-tooltip" aria-label="読みで入力する場合は句読点や記号は不要">?</span>
				</div>
				<input type="text" class="input-text" placeholder="作品名などを入力" asp-for="searchCondition.Tieup" title="読みで入力する場合は句読点や記号は不要">
			</div>
			<!-- メンバー -->
			<div class="form-group full-width">
				<div class="member-row">
					<label class="field-label">メンバー</label>
					<div class="member-options">
						<div class="radio-group">
							@foreach (var member in Model.memberList)
							{
								<label class="radio-label">
									<input type="radio" asp-for="searchCondition.Member" value="@member.MemberCode"> @member.MemberName
								</label>
							}
						</div>
						<label class="toggle-label toggle-inline">
							<span class="toggle-status toggle-status-on">歌った曲</span>
							<input type="checkbox" class="toggle-input" asp-for="searchCondition.IsSungOnly">
							<span class="toggle-track" aria-hidden="true"><span class="toggle-thumb"></span></span>
						</label>
					</div>
				</div>
			</div>
		</div>
		<!-- 検索ボタン -->
		<div class="form-actions">
			<button type="submit" class="btn-search">検索</button>
			<button type="submit" class="btn-random" name="randomize" value="true">ランダム</button>
			<a asp-action="Index" class="btn-reset">リセット</a>
		</div>			
	</form>
</div>
<!-- 曲一覧 -->
<div class="result-form">
	<!-- 件数バー -->
	<div class="result-info-bar">
		<span class="result-count">該当件数: <strong>@Model.ListCount</strong> 件</span>
		<div class="mobile-sort-controls" aria-label="一覧の並び替え">
			<label class="mobile-sort-control">
				<span>並び順</span>
				<select class="select-box mobile-sort-key">
					<option value="SongName">曲名</option>
					<option value="ArtistName">アーティスト名</option>
					<option value="LastSungDate">最終歌唱日</option>
					<option value="SungCount">歌唱回数</option>
				</select>
			</label>
			<label class="mobile-sort-control">
				<select class="select-box mobile-sort-direction">
					<option value="asc">昇順</option>
					<option value="desc">降順</option>
				</select>
			</label>
		</div>
	</div>
	<div class="list-container">
		<div class="list-header song-list-grid">
			<div class="col-center">詳細</div>
			<div class="sort-col" data-sort-key="SongName" onclick="sortTable('SongName')">曲名<span id="icon-title">↕</span></div>
			<div class="sort-col" data-sort-key="ArtistName" onclick="sortTable('ArtistName')">アーティスト名 <span id="icon-artist">↕</span></div>
			<div aria-hidden="true"></div>
			<div class="sort-col" data-sort-key="LastSungDate" onclick="sortTable('LastSungDate')">最終歌唱日 <span id="icon-lastsungdate">↕</span></div>
			<div class="sort-col col-count" data-sort-key="SungCount" onclick="sortTable('SungCount')">歌唱回数 <span id="icon-count">↕</span></div>
		</div>
		<div id="result-item">
			@foreach (SongList.Models.ViewModels.SongListModel item in Model.songList)
				{
					<div class="list-item song-list-grid" data-song-name="@item.SongName" data-artist-name="@item.ArtistName" data-last-sung-date="@item.LastSungDate" data-sung-count="@item.SungCount">
						<div class="col-center">
							<div class="action-buttons">
								<form method="post" asp-action="Details">
									@if (!string.IsNullOrWhiteSpace(item.LastSungDate))
									{
										<button type="submit" class="btn-detail">詳細</button>
									}
									<input type="hidden" name="songId" value="@item.SongId" />
									<input type="hidden" name="memberCode" value="@item.MemberCode" />
								</form>
							</div>
						</div>
						<div class="song-title">
							<div class="song-name-row">
								<button type="button" class="btn-copy" data-copy-text="@item.SongName / @item.ArtistName" aria-label="曲名とアーティスト名をコピー" title="コピー">
									<span aria-hidden="true">⧉</span>
								</button>
								<span class="song-name">@item.SongName</span>
								@if (!string.IsNullOrWhiteSpace(item.TieupName))
								{
									<small class="song-tieup">（@item.TieupName）</small>
								}
							</div>
						</div>
						<div class="artist-name">@item.ArtistName</div>
						<div class="genre-list">
							@{
								var genreMappings = new Dictionary<string, string>
								{
									{ "01", "jpop" },
									{ "02", "anison" },
									{ "03", "ghibli" },
									{ "04", "vocaloid" },
									{ "05", "original" },
									{ "06", "vtuber" },
									{ "07", "idol" },
									{ "08", "utaite" },
									{ "09", "chorus" },
									{ "10", "doyo" },
									{ "11", "enka" },
									{ "12", "western" }
								};
								var codes = item.GenreCode.Split(separator: '\t', StringSplitOptions.TrimEntries);
								var names = item.GenreName.Split(separator: '\t', StringSplitOptions.TrimEntries);
							}
							@foreach (var (code, name) in codes.Zip(names))
							{
								var className = genreMappings.TryGetValue(code, out var value) ? value : "jpop";
								<span class="status-badge @className">@name</span>
							}
						</div>
						<div class="last-sung-date">@item.LastSungDate</div>
						<div class="col-count">
							@if (!string.IsNullOrWhiteSpace(item.LastSungDate))
							{
								<span class="mobile-last-sung-date">最終：@item.LastSungDate</span>
							}
							<span class="count-badge">@item.SungCount 回</span>
						</div>
					</div>
				}
		</div>
	</div>
	<div id="copy-toast" class="copy-toast" aria-live="polite" aria-atomic="true">コピーしました</div>
</div>
